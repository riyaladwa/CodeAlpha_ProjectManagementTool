{
  "name": "taskflow-ai",
  "version": "1.0.0",
  "description": "TaskFlow AI - Smart Project Management & Sprint Collaboration Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "vite",
    "start": "node server/src/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node --test server/tests/*.test.js",
    "seed": "node server/src/utils/seedData.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hello-pangea/dnd": "^18.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.55.0",
    "mongoose": "^8.13.1",
    "morgan": "^1.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^10.1.4",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
